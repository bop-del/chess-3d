{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Critic verdict of one lane and one round (.tmp/critic/round-<n>.json), CHE-388",
  "type": "object",
  "required": ["lane", "key", "round", "critic", "date", "variants"],
  "properties": {
    "lane": { "type": "string", "minLength": 1 },
    "key": { "type": "string", "pattern": "^CHE-[0-9]+$" },
    "round": { "type": "integer", "minimum": 1 },
    "critic": { "type": "string", "minLength": 1 },
    "date": { "type": "string", "format": "date-time" },
    "variants": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "score", "rank", "fixed", "deferred", "pros", "cons", "pref"],
        "properties": {
          "id": { "type": "string", "minLength": 1, "description": "the variant id of the clips index.json" },
          "label": { "type": "string", "description": "German name for the morning page option" },
          "score": { "type": "integer", "minimum": 1, "maximum": 10 },
          "rank": { "type": "integer", "minimum": 1, "description": "1 = best, unique, never better than a higher score" },
          "fixed": { "type": "array", "items": { "type": "string" } },
          "deferred": { "type": "array", "items": { "type": "string" } },
          "pros": { "type": "array", "items": { "type": "string" }, "description": "German, shown on the morning page" },
          "cons": { "type": "array", "items": { "type": "string" }, "description": "German, shown on the morning page" },
          "pref": { "type": "boolean", "description": "the critic's recommendation" },
          "why": { "type": "string", "description": "German, one line for the recommendation" }
        }
      }
    }
  }
}
