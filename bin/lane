#!/usr/bin/env node
// Lanes: one branch, one git worktree and one Herdr workspace per backlog item or agent round.
// Usage:
//   bin/lane open <branch> [--key CHE-n]... [--private]     name lanes che-<n>-words (e.g. che-177-private-worktrees); an old item id name (s73-...) needs --key
//                                       worktree and workspace "<branch>" under ~/.herdr/worktrees/chess-3d/, its first
//                                       tab "diff" running hunk diff main --watch, node_modules linked in, fast tier run.
//                                       With the private tools present the lane needs a Linear key: the item's CHE key in BACKLOG.md
//                                       (one sync is run when there is none), or --key, several times for a lane that carries several
//                                       items. Without any key nothing is created and the fix is printed.
//                                       --private (S71): the lane also touches the private repo, so it gets its own git worktree of it,
//                                       ~/.herdr/worktrees/chess-3d-private/<branch> (private bin/private-lane), and a second hunk tab
//                                       "diff private". A brief line `Private repo: yes` makes bin/lane agent do the same.
//                                       --agent <name> <brief> [--model <m>] (CHE-194): after the lane is open and the fast tier green, the same as
//                                       bin/lane agent <branch> <name> <brief> [--model <m>]: one command for the lane, its private worktree and the builder.
//   bin/lane agent <branch> <name> <brief> [--model <m>]
//                                       a tab "<name> agent" in the lane's workspace with a visible Claude session
//                                       (plus, once per lane, a "diff" tab running hunk diff main --watch)
//                                       (default model sonnet), prompted to read the brief and to send its final
//                                       report to the lead session (Herdr agent chess-3d-lead). With the private
//                                       bin/agent-stop-hook present, the agent also gets a Stop hook that saves its report.
//                                       With the private agents/builder.md present, the prompt starts with it, then `Mode for this brief:`
//                                       builder or engineer, from the brief's `Mode:` line (builder when missing; tools/lane-identity.mjs, CHE-104).
//   bin/lane list                       open lanes of this repo
//   bin/lane land <branch> [-m <msg>]   land a green lane with no agent (the private bin/land-lane): lock, merge main, fast tier, the
//                                       lane's affected smoke groups, release-next add, then close below; prints `landed <sha>`,
//                                       `red: <step>` or `conflict: <files>` (exit 0, 1, 3). Needs the private repo's bin/land-lane.
//   bin/lane close <branch> [-m <msg>] [--no-linear]
//                                       squash merge into main (the main checkout, which must be on main), then remove the
//                                       workspace, the worktree and the branch. Without -m the lane's only commit message
//                                       is reused; a lane with several commits needs -m. A private worktree of the lane is squash merged into
//                                       private main with the same message and removed too (live files never; checked before anything merges).
//                                       With the private tools present it takes the land
//                                       lock first (bin/land-lock; a lock held by this same lane counts as ours) and records the lane's
//                                       release test steps from its report before the worktree is removed. A lane with no Linear key on
//                                       record is refused before anything is merged (exit 1, a RED line); --no-linear skips Linear for
//                                       a lane that tracks no issue. The squash commit subject gets ' (CHE-n[, CHE-m])' for the recorded keys it lacks, from the recorded
//                                       keys when it names none.
// Exit codes: 0 done, 1 a step failed (nothing after it ran), 2 usage error.
import { execFileSync, spawnSync } from 'node:child_process';
import { existsSync, lstatSync, mkdirSync, readFileSync, symlinkSync, writeFileSync } from 'node:fs';
import { dirname, join, resolve } from 'node:path';
import { fileURLToPath } from 'node:url';
import { parseLaneFlags } from '../tools/lane-args.mjs';
import { agentPrompt } from '../tools/lane-identity.mjs';

const ROOT = resolve(dirname(fileURLToPath(import.meta.url)), '..');
const USAGE = 'usage: bin/lane open <che-n-words | branch --key CHE-n> [--key CHE-n]... [--private] [--agent <name> <brief> [--model <m>]] | bin/lane agent <branch> <name> <brief> [--model <m>] | bin/lane list | bin/lane land <branch> [-m <message>] | bin/lane close <branch> [-m <message>] [--no-linear]';
const LEAD = 'chess-3d-lead';   // the lead session\'s Herdr agent name
const die = (msg, code = 1) => { console.error(msg); process.exit(code); };
// the main clone, also when this script runs from inside a lane. Every git command below runs there.
const MAIN = resolve(execFileSync('git', ['rev-parse', '--path-format=absolute', '--git-common-dir'], { cwd: ROOT, encoding: 'utf8' }).trim(), '..');
const run = (cmd, args, opts = {}) => execFileSync(cmd, args, { cwd: MAIN, encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'], ...opts }).trim();
const git = (...a) => run('git', a);
const herdr = (...a) => JSON.parse(run('herdr', a)).result;

// S71: the private repo's worktree of a lane (optional private tool bin/private-lane; null when the tool is absent)
const privateLaneTool = () => { const h = join(process.env.HOME, 'code', 'chess-3d-private', 'bin', 'private-lane'); return existsSync(h) ? h : null; };
const privateLane = (...a) => { const h = privateLaneTool(); if (!h) return { status: 127, stdout: '', stderr: 'no private bin/private-lane' }; return spawnSync(process.execPath, [h, ...a], { encoding: 'utf8', timeout: 120000 }); };
const privatePathOf = (branch) => { const r = privateLane('path', branch); return r.status === 0 ? r.stdout.trim() : null; };

function lanes() {
  const res = herdr('worktree', 'list', '--cwd', MAIN);
  const list = res.worktrees || res.items || [];
  return list.filter((w) => w.is_linked_worktree);
}

// a release prep lane (v150-release-prep, named by lib/release-start.mjs) tracks no issue: no key at open, none at close
const releasePrep = (branch) => /^v\d+-release-prep$/.test(branch || '');

const linearHook = () => { const h = join(process.env.HOME, 'code', 'chess-3d-private', 'bin', 'linear-hook'); return existsSync(h) ? h : null; };   // optional private hook

// The keys a new lane gets, asked before anything is created (S69: lanes were opened seconds before the sync made the CHE key, so
// the hook recorded none and close moved nothing). null: no private tools, nothing to enforce; []: Linear is switched off.
function laneKeys(branch, given) {
  const h = linearHook();
  if (!h) return null;
  const ask = (extra = []) => spawnSync(h, ['resolve', branch, ...given.flatMap((k) => ['--key', k]), ...extra], { encoding: 'utf8', timeout: 120000 });
  let r = ask();
  if (r.status === 1) r = ask(['--sync']);   // not in BACKLOG.md yet: one sync may create the key, then match again
  if (r.status === 2) die(`lane ${branch} not opened: ${(r.stderr || r.stdout).trim()}`);
  if (r.status !== 0) die(`lane ${branch} not opened: its item has no CHE key in BACKLOG.md, so Linear could not follow the lane.\nFix: add a ### NEW block for the item, run bin/linear sync, or pass --key CHE-n (several times for several items).`);
  const out = r.stdout.trim();
  return out === 'off' ? [] : out.split(/\s+/).filter(Boolean);
}

function open(branch, given = [], withPrivate = false, withAgent = null, model = 'sonnet') {
  if (!/^[a-z0-9][a-z0-9-]*$/.test(branch || '')) die(`branch names are lower case words joined by hyphens, best che-<n>-words\n${USAGE}`, 2);
  if (git('branch', '--list', branch)) die(`branch ${branch} exists already`);
  // owner, 2026-10-04: the Linear key is the only id. A lane named after an old item id (s73-..., n8-...) without --key is refused.
  if (!given.length && !releasePrep(branch) && /^[a-z]+\d+-/.test(branch) && linearHook()) die(`lane ${branch} not opened: it starts with an old item id. Name lanes che-<n>-words (the Linear key is the only id, for example che-177-private-worktrees), or pass --key CHE-n.`);
  if (withAgent && (!/^[a-z0-9][a-z0-9-]*$/.test(withAgent.name) || !existsSync(withAgent.brief))) die(`lane ${branch} not opened: --agent needs a lower case name and an existing brief file (${withAgent.brief})`, 2);
  if (withPrivate && !privateLaneTool()) die(`lane ${branch} not opened: --private needs ~/code/chess-3d-private/bin/private-lane`);
  const keys = releasePrep(branch) && !given.length ? [] : laneKeys(branch, given);
  const res = herdr('worktree', 'create', '--cwd', MAIN, '--branch', branch, '--base', 'main', '--label', branch, '--no-focus');
  const path = res.worktree.path, ws = res.workspace.workspace_id, tab = res.tab.tab_id;
  // the first tab shows the lane's changes against main, live (hunk); a lane needs no plain shell tab
  run('herdr', ['tab', 'rename', tab, 'diff']);
  const nm = join(path, 'node_modules');
  if (!existsSync(nm)) symlinkSync(join(MAIN, 'node_modules'), nm);
  let priv = null;
  if (withPrivate) {
    const r = privateLane('open', branch);
    if (r.status !== 0) die(`lane ${branch}: the public worktree is open (${path}) but the private worktree failed: ${(r.stderr || r.stdout).trim()}\nFix it, then run bin/private-lane open ${branch}`);
    priv = r.stdout.trim();
  }
  console.log(`lane ${branch}: ${path}${priv ? `\nprivate worktree: ${priv}` : ''}\nworkspace ${ws} "${branch}", first tab "diff" (hunk diff main --watch)${keys && keys.length ? `\nLinear: ${keys.join(', ')}` : ''}`);
  { const h = linearHook(); if (h) spawnSync(h, ['open', branch, ...(keys || [])], { stdio: 'ignore', timeout: 20000 }); }   // optional private hook, never blocks a lane
  const t = spawnSync(process.execPath, ['test/run.mjs'], { cwd: path, encoding: 'utf8' });
  const pane = (res.root_pane || {}).pane_id;
  if (pane) { run('herdr', ['pane', 'send-text', pane, 'hunk diff main --watch']); run('herdr', ['pane', 'send-keys', pane, 'Enter']); }
  if (priv) ensurePrivateDiffTab({ open_workspace_id: ws }, priv);
  console.log(t.status === 0 ? 'fast tier green in the lane' : `FAST TIER RED in the lane, fix before building on it:\n${t.stdout}${t.stderr}`);
  // CHE-194: --agent runs lane open, the private worktree (--private) and bin/lane agent in one go; a red lane starts no agent
  if (withAgent && t.status !== 0) { console.log(`agent ${withAgent.name} not started: the lane is red`); process.exit(1); }
  if (withAgent) agent(branch, withAgent.name, withAgent.brief, model);
  process.exit(t.status === 0 ? 0 : 1);
}

// A "diff" tab per lane running `hunk diff main --watch`: the lane's changes against main, live, while agents work.
function ensureDiffTab(lane) {
  const tabs = (herdr('tab', 'list', '--workspace', lane.open_workspace_id).tabs || []);
  if (tabs.some((t) => t.label === 'diff')) return;
  const tab = herdr('tab', 'create', '--workspace', lane.open_workspace_id, '--cwd', lane.path, '--label', 'diff');
  const pane = (tab.root_pane || tab.pane || {}).pane_id;
  if (!pane) return;
  run('herdr', ['pane', 'send-text', pane, 'hunk diff main --watch']);
  run('herdr', ['pane', 'send-keys', pane, 'Enter']);
}

// S71: a second tab "diff private" with the private worktree's diff against private main (a lane touching both repos shows both)
function ensurePrivateDiffTab(lane, privPath) {
  const tabs = (herdr('tab', 'list', '--workspace', lane.open_workspace_id).tabs || []);
  if (tabs.some((t) => t.label === 'diff private')) return;
  const tab = herdr('tab', 'create', '--workspace', lane.open_workspace_id, '--cwd', privPath, '--label', 'diff private');
  const pane = (tab.root_pane || tab.pane || {}).pane_id;
  if (!pane) return;
  run('herdr', ['pane', 'send-text', pane, 'hunk diff main --watch']);
  run('herdr', ['pane', 'send-keys', pane, 'Enter']);
}

function agent(branch, name, brief, model = 'sonnet') {
  if (!/^[a-z0-9][a-z0-9-]*$/.test(name || '')) die(`agent names are lower case words joined by hyphens\n${USAGE}`, 2);
  if (!existsSync(brief || '')) die(`brief not found: ${brief}`, 2);
  const lane = lanes().find((w) => w.branch === branch);
  if (!lane || !lane.open_workspace_id) die(`no open lane ${branch} with a workspace: bin/lane open ${branch} first`);
  ensureDiffTab(lane);
  // S71: a brief that says `Private repo: yes` gives the lane its private worktree (once), and its diff tab
  let priv = privatePathOf(branch);
  if (!priv && privateLaneTool() && /^private repo:\s*yes\b/im.test(readFileSync(brief, 'utf8'))) {
    const r = privateLane('open', branch);
    if (r.status !== 0) die(`the brief says Private repo: yes but the private worktree failed: ${(r.stderr || r.stdout).trim()}`);
    priv = r.stdout.trim();
  }
  if (priv) ensurePrivateDiffTab(lane, priv);
  const tab = herdr('tab', 'create', '--workspace', lane.open_workspace_id, '--cwd', lane.path, '--label', `${name} agent`);
  const pane = (tab.root_pane || tab.pane || {}).pane_id;
  if (!pane) die(`could not read the new tab's pane from herdr: ${JSON.stringify(tab).slice(0, 200)}`);
  const id = `${branch}-${name}`;
  // optional private hook: a Stop hook that keeps the agent's final report (settings file per agent, in the lane's gitignored .claude/)
  const extra = [];
  { const h = join(process.env.HOME, 'code', 'chess-3d-private', 'bin', 'agent-stop-hook');
    if (existsSync(h)) {
      const f = join(lane.path, '.claude', `agent-${name}.settings.json`);
      mkdirSync(dirname(f), { recursive: true });
      // land agents (bin/land-all --land) may run exactly the local landing: the land lock and bin/lane close (owner, 2026-10-03)
      // the lock is taken and released only through the private helper (owner.json, stale takeover; S34), not mkdir/rmdir
      const root = join(process.env.HOME, 'code', 'chess-3d'), lockTool = join(process.env.HOME, 'code', 'chess-3d-private', 'bin', 'land-lock');
      // land and release prep agents also feed the release test draft and the result records (S27)
      const relTool = (t) => `Bash(${join(process.env.HOME, 'code', 'chess-3d-private', 'bin', t)} *)`;
      const permissions = name === 'land' ? { allow: [`Bash(${lockTool} *)`, `Bash(${root}/bin/lane close *)`, `Bash(bin/lane close *)`, relTool('release-next'), relTool('release-result')] }
        : name === 'release' ? { allow: [relTool('release-next'), relTool('release-result')] } : undefined;
      writeFileSync(f, JSON.stringify({ hooks: { Stop: [{ hooks: [{ type: 'command', command: `node ${h} ${branch} ${name}` }] }] }, ...(permissions ? { permissions } : {}) }, null, 2));
      extra.push('--settings', f);
    } }
  // a fresh tab needs a moment before its shell takes input: retry while herdr says the pane is busy
  for (let i = 0; ; i++) {
    try {
      run('herdr', ['agent', 'start', id, '--kind', 'claude', '--pane', pane, '--timeout', '60000', '--',
        '--model', model, '--plugin-dir', join(process.env.HOME, 'code', 'mattpocock-skills'), ...extra]);
      break;
    } catch (e) {
      if (i >= 10 || !/agent_pane_busy/.test(String(e.stderr || e.stdout || e.message))) throw e;
      spawnSync('sleep', ['1']);
    }
  }
  const prompt = `You are the "${name}" agent of lane ${branch} (worktree ${lane.path}). Read your brief at ${resolve(brief)} and follow it exactly. `
    + `When you are done, write your final report to .tmp/${name}/report.md in the lane AND send it to the lead session with: herdr agent prompt ${LEAD} "<your report>" (one message, plain text). `
    + (priv ? `This lane also has a private repo worktree: ${priv}. Edit the private repo files ONLY there (never ~/code/chess-3d-private itself), commit WIP there with git add -A and a message ending in [no-doc]. board.json, pulse.json, sdlc-events.jsonl, metrics/, .tmp/, review/out/ and RESTART-PROMPT.md are live files: never commit them. ` : '')
    + 'If the send is refused (the lead may be waiting on the owner), retry every 2 minutes, at most 10 times. '
    + 'Then stop and wait; the lead may message you with follow ups.';
  // CHE-104: the private agents/builder.md (identity, owner, goals, mode) goes first when it exists
  run('herdr', ['agent', 'prompt', id, agentPrompt(prompt, brief)]);
  console.log(`agent ${id} started in tab "${name} agent" of workspace ${lane.open_workspace_id} (${model}); it reports to ${LEAD}`);
}

function list() {
  const ls = lanes();
  if (!ls.length) { console.log('no open lanes'); return; }
  for (const w of ls) { const pp = privatePathOf(w.branch); console.log(`${(w.branch || '?').padEnd(28)} ${w.path}${w.open_workspace_id ? `  (workspace ${w.open_workspace_id})` : '  (no workspace)'}${pp ? `  (private ${pp})` : ''}`); }
}

// S54: a hand run `bin/lane close` takes the land lock (private bin/land-lock) so it never overlaps the land script or a land agent, which
// hold the lock themselves while they close (--same-lane-ok: a lock held by this lane counts as ours). Without the private tool: no lock.
function withLandLock(branch, fn) {
  const tool = process.env.LAND_LOCK_BIN || join(process.env.HOME, 'code', 'chess-3d-private', 'bin', 'land-lock');
  if (!existsSync(tool)) return fn();
  const t = spawnSync(process.execPath, [tool, 'take', '--lane', branch, '--agent', 'close', '--same-lane-ok', '--wait', process.env.LAND_LOCK_WAIT_MIN || '20'], { encoding: 'utf8' });
  if (t.status !== 0) die(`the land lock is busy, nothing was closed: ${(t.stdout || t.stderr).trim()}`);
  const mine = !/held by this lane/.test(t.stdout);
  // die() exits the process, so the release hangs on 'exit' rather than a finally
  if (mine) process.once('exit', () => { spawnSync(process.execPath, [tool, 'release', '--lane', branch, '--agent', 'close'], { stdio: 'ignore' }); });
  return fn();
}

function close(branch, message, noLinear = false) {
  if (!branch) die(USAGE, 2);
  withLandLock(branch, () => closeLocked(branch, message, noLinear));
}

function closeLocked(branch, message, noLinear) {
  if (git('branch', '--show-current') !== 'main') die(`the main checkout ${MAIN} is not on main`);
  if (git('status', '--porcelain')) die('main has uncommitted changes: commit or stash them first');
  const lane = lanes().find((w) => w.branch === branch);
  const path = lane ? lane.path : null;
  if (path && run('git', ['status', '--porcelain'], { cwd: path })) die(`lane ${branch} has uncommitted changes: commit them in the lane first`);
  const commits = git('rev-list', `main..${branch}`).split('\n').filter(Boolean);
  // S71: the lane's private worktree. Everything that could stop its squash is checked now, before the public repo is touched.
  const hasPriv = !!privatePathOf(branch);
  let privAhead = 0;
  if (hasPriv) {
    const pf = privateLane('preflight', branch);
    if (pf.status !== 0) die(`private worktree of ${branch} is not ready, nothing was merged or removed: ${(pf.stderr || pf.stdout).trim()}`);
    privAhead = JSON.parse(privateLane('state', branch).stdout).ahead;
  }
  if (!commits.length && !privAhead) {   // a lane without a merge (research, previews): nothing to squash, just remove it
    if (hasPriv) privateLane('drop', branch);
    if (lane && lane.open_workspace_id) run('herdr', ['worktree', 'remove', '--workspace', lane.open_workspace_id]);
    else if (path) git('worktree', 'remove', path);
    git('branch', '-D', branch);
    console.log(`lane ${branch} had no commits beyond main: removed it without a merge (its .tmp went with it)`);
    return;
  }
  // S69: a lane with no Linear key on record is refused before anything is merged; after the squash it would be too late to move the issue
  let keys = [];
  if (!noLinear && !releasePrep(branch)) {
    const h = linearHook();
    if (h) {
      const c = spawnSync(h, ['check', branch], { encoding: 'utf8', timeout: 60000 });
      if (c.status !== 0) die(`RED: lane ${branch} has no Linear key on record, nothing was merged or removed.\nFix: bin/linear lane-open ${branch} <KEY...> (the keys the lane carries), then close again; or close with --no-linear for a lane that tracks no issue.`);
      keys = c.stdout.trim() === 'off' ? [] : c.stdout.trim().split(/\s+/).filter(Boolean);
    }
  }
  if (!message) {
    if (commits.length > 1) die(`lane ${branch} has ${commits.length} commits: pass -m with the squash commit message`);
    if (commits.length) message = git('log', '-1', '--format=%B', branch);
    else { if (privAhead > 1) die(`private worktree of ${branch} has ${privAhead} commits: pass -m with the squash commit message`); message = privateLane('message', branch).stdout.trim(); if (!message) die(`private worktree of ${branch} has no usable commit message (only WIP): pass -m`); }
  }
  // every recorded CHE key is part of the squash commit subject (CHE-197): the ones the first line lacks are appended (git log --grep finds them later)
  if (keys.length) { const [first, ...more] = message.split('\n'); const miss = keys.filter((k) => !first.includes(k)); if (miss.length) message = [`${first.trimEnd()} (${miss.join(', ')})`, ...more].join('\n'); }
  if (commits.length) {
    const m = spawnSync('git', ['merge', '--squash', branch], { cwd: MAIN, encoding: 'utf8' });
    if (m.status !== 0) { spawnSync('git', ['merge', '--abort'], { cwd: MAIN }); spawnSync('git', ['reset', '--hard', 'HEAD'], { cwd: MAIN }); die(`squash merge of ${branch} failed, main is unchanged:\n${m.stdout}${m.stderr}`); }
    run('git', ['commit', '-q', '-F', '-'], { input: message, stdio: ['pipe', 'pipe', 'pipe'] });
    console.log(`squash merged ${branch} into main: ${git('log', '-1', '--format=%h %s')}`);
  }
  // S71: the private worktree is squash merged into private main with the same message (key included), then removed with its branch
  if (hasPriv) {
    const pc = privateLane('close', branch, '-m', message);
    if (pc.status !== 0) die(`RED: ${commits.length ? 'the public squash is on main, but ' : ''}the private squash of ${branch} failed, the lane was not removed: ${(pc.stderr || pc.stdout).trim()}\nFix it, then run bin/private-lane close ${branch} -m "<message>" and bin/lane close ${branch} again.`);
    console.log(pc.stdout.trim());
  }
  // the lane's release test steps are read from its builder report while the worktree still exists (S54; idempotent after bin/land-lane's own add)
  { const h = join(process.env.HOME, 'code', 'chess-3d-private', 'bin', 'release-next'); if (path && existsSync(h)) spawnSync(process.execPath, [h, 'add', '--lane', branch, '--dir', path], { stdio: 'ignore', timeout: 20000 }); }   // optional private hook
  { const h = noLinear || releasePrep(branch) ? null : linearHook(); if (h) spawnSync(h, ['close', branch, git('log', '-1', '--format=%h')], { stdio: ['ignore', 'ignore', 'inherit'], timeout: 20000 }); }   // optional private hook, a RED line stays visible
  if (lane && lane.open_workspace_id) run('herdr', ['worktree', 'remove', '--workspace', lane.open_workspace_id]);
  else if (path) git('worktree', 'remove', path);
  git('branch', '-D', branch);
  console.log(`removed the lane: ${lane && lane.open_workspace_id ? `workspace ${lane.open_workspace_id}, ` : ''}worktree${path ? ` ${path}` : ''}, branch ${branch}`);
  console.log('Servers the lane started are not stopped here: stop them by PID. Pushing needs the owner\'s go.');
}

// landing by script (S49): hands over to the private bin/land-lane, which ends in `bin/lane close` itself
function land(branch, message) {
  const h = join(process.env.HOME, 'code', 'chess-3d-private', 'bin', 'land-lane');
  if (!existsSync(h)) die('bin/lane land needs ~/code/chess-3d-private/bin/land-lane (the private landing script)');
  const r = spawnSync(process.execPath, [h, branch, ...(message ? ['-m', message] : [])], { stdio: 'inherit', env: { ...process.env, LAND_MAIN: MAIN } });
  process.exit(r.status ?? 1);
}

const [cmd, ...rest] = process.argv.slice(2);
// open <branch> [--key CHE-n]... [--private] [--agent <name> <brief> [--model <m>]]  and  close <branch> [-m <msg>] [--no-linear]
const flags = (args, spec) => { try { return parseLaneFlags(args, spec); } catch (e) { die(USAGE, 2); } };
try {
  if (cmd === 'open') { const o = flags(rest, { key: true, priv: true, agent: true }); if (o.pos.length !== 1) die(USAGE, 2); open(o.pos[0], o.key, !!o.priv, o.agent, o.model); }
  else if (cmd === 'agent' && (rest.length === 3 || (rest.length === 5 && rest[3] === '--model'))) agent(rest[0], rest[1], rest[2], rest[4]);
  else if (cmd === 'list' && !rest.length) list();
  else if (cmd === 'land' && (rest.length === 1 || (rest.length === 3 && rest[1] === '-m'))) land(rest[0], rest[2]);
  else if (cmd === 'close') { const o = flags(rest, { m: true, noLinear: true }); if (o.pos.length !== 1) die(USAGE, 2); close(o.pos[0], o.m, !!o.noLinear); }
  else die(USAGE, 2);
} catch (e) {
  die(`lane ${cmd} failed: ${String(e.stderr || e.message).trim().split('\n').slice(-3).join(' | ')}`);
}
